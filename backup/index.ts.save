const startUsdc = 1000;
const endUsdc = 1005.60;
const estimatedCosts = 0.60;

const netUsdc = endUsdc - startUsdc - estimatedCosts;
const netPercent = (netUsdc / startUsdc) * 100;

console.log("=== DEX Scanner MOCK ===");
console.log(`Alussa: ${startUsdc} USDC`);
console.log(`Lopussa: ${endUsdc} USDC`);
console.log(`Arvioidut kulut: ${estimatedCosts} USDC`);
console.log(`Nettoero: ${netUsdc.toFixed(2)} USDC`);
console.log(`Nettoero: ${netPercent.toFixed(2)} %`);

if (netPercent >= 0.3) {
  console.log("🚨 MOCK-HÄLYTYS: mahdollinen arbitraasitilanne");
} else {
  console.log("Ei hälytystä.");
}

